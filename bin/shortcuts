#!/usr/bin/env python3
"""Install the plugin's commands as personal /speaker-* shortcuts.

Plugin commands are namespaced (`/speaker:on`). Personal commands, living in
~/.claude/commands, are not — so a copy of `on.md` named `speaker-on.md` there
is invoked as `/speaker-on`. The copies keep pointing at the same `bin/speak`,
since the loader in each command searches the plugin cache too.

Every generated file carries MARKER, and `uninstall` removes only files that
carry it: a hand-written command of yours with the same name is left alone.
"""
import sys
from pathlib import Path

MARKER = "<!-- generated by claude-speaker; remove with: speak shortcuts uninstall -->"
PREFIX = "speaker-"

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
SRC = PLUGIN_ROOT / "commands"
DEST = Path.home() / ".claude" / "commands"


def target(src: Path) -> Path:
    return DEST / f"{PREFIX}{src.name}"


def render(src: Path) -> str:
    body = src.read_text()
    # inside a personal command the namespaced form does not exist
    body = body.replace("/speaker:", "/" + PREFIX)
    return f"{body.rstrip()}\n\n{MARKER}\n"


def generated(path: Path) -> bool:
    try:
        return MARKER in path.read_text()
    except OSError:
        return False


def install() -> int:
    DEST.mkdir(parents=True, exist_ok=True)
    written, skipped = [], []
    for src in sorted(SRC.glob("*.md")):
        dst = target(src)
        if dst.exists() and not generated(dst):
            skipped.append(dst.name)
            continue
        dst.write_text(render(src))
        written.append(dst.name)
    for name in written:
        print(f"  + /{name[:-3]}")
    print(f"{len(written)} shortcut(s) in {DEST}")
    if skipped:
        print("\nleft untouched (not generated by this script):")
        for name in skipped:
            print(f"  ! {name} — rename or delete it, then run install again")
        return 1
    return 0


def uninstall() -> int:
    removed = []
    for path in sorted(DEST.glob(f"{PREFIX}*.md")):
        if generated(path):
            path.unlink()
            removed.append(path.name)
    for name in removed:
        print(f"  - /{name[:-3]}")
    print(f"{len(removed)} shortcut(s) removed from {DEST}")
    return 0


def status() -> int:
    live = [p for p in sorted(DEST.glob(f"{PREFIX}*.md")) if generated(p)]
    if not live:
        print(f"no /{PREFIX}* shortcuts installed (install them with: "
              f"speak shortcuts install)")
        return 0
    print(f"{len(live)} shortcut(s) in {DEST}:")
    for path in live:
        print(f"  /{path.name[:-3]}")
    return 0


def main(argv: list[str]) -> int:
    action = argv[0] if argv else "status"
    if action == "install":
        return install()
    if action == "uninstall":
        return uninstall()
    if action == "status":
        return status()
    print(f"usage: {Path(sys.argv[0]).name} [install|uninstall|status]",
          file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
